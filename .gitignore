*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular cache
.angular/
**/.angular/

# TypeScript cache
*.tsbuildinfo

# Package lock (keep package-lock.json but ignore yarn.lock if using npm)
# yarn.lock

